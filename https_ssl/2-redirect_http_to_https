global
    daemon
    maxconn 256

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http-in
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/www.bdushime.tech.pem
    redirect scheme https code 301 if !{ ssl_fc }
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7266-web-01 13.135.166.102:80 check
    server 7266-web-02 35.179.145.213:80 check
